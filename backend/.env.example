# Fastify Backend Environment Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/emetrology_db?sslmode=require"
JWT_SECRET_KEY="generate-a-secure-64-character-hex-secret-for-production"
EVIDENCE_SECRET="generate-a-secure-64-character-hex-secret-for-production"
NODE_ENV="production"
PORT=8000
HOST="0.0.0.0"
LOG_LEVEL="info"
ALLOW_DEV_HEADERS="false"

# Production Frontend Origins for CORS (comma-separated or single)
FRONTEND_URL="https://verification-web.vercel.app"
ADMIN_URL="https://admin-portal.vercel.app"
ALLOWED_ORIGINS="https://verification-web.vercel.app,https://admin-portal.vercel.app"

# Optional: Google Gemini API Key for Nikks statutory AI chatbot
GEMINI_API_KEY=""

# Database Reset in Production (Leave false or omitted in production)
ENABLE_PROD_RESET="false"
